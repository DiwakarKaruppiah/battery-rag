# Copy to .env and edit.  `.env` is git-ignored — never commit API keys.

# --- LLM (any LiteLLM model string) ---------------------------------------
# Free + private (your PDFs never leave the laptop):  install Ollama, then `ollama pull qwen3:8b`
LLM_MODEL=ollama/qwen3:8b
# Or a hosted model (better answers, small cost) — set the matching key below:
# LLM_MODEL=anthropic/<model-name>
# LLM_MODEL=openai/<model-name>
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Vision model for figure descriptions (must accept images), e.g. ollama/qwen2.5vl:7b or a hosted model
# VISION_MODEL=ollama/qwen2.5vl:7b
# Judge for evaluation — use the strongest model you can afford; small local judges are noisy
# JUDGE_MODEL=

# --- Zotero -------------------------------------------------------------------
# Default is ~/Zotero/storage ; change if your Zotero data directory is elsewhere
# ZOTERO_STORAGE=/Users/you/Zotero/storage

# --- Retrieval -------------------------------------------------------------------
# DENSE_MODEL=BAAI/bge-small-en-v1.5        # upgrade: BAAI/bge-base-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3    # faster on CPU: BAAI/bge-reranker-base
# MIN_RERANK_SCORE=0.25
# TOP_K_RETRIEVE=30
# TOP_K_CONTEXT=6

# Run Qdrant as a server (docker compose up -d) so the app and the MCP server can share it
# QDRANT_URL=http://localhost:6333
